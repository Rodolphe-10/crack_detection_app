# Copiez ce fichier vers .streamlit/secrets.toml et remplissez vos clés.
# Ne commitez jamais secrets.toml.

GROQ_API_KEY = "your_groq_api_key_here"

[email]
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USERNAME = "your_email@gmail.com"
SMTP_PASSWORD = "your_app_password_here"
USE_TLS = true

[monitoring]
ENABLE_ANALYTICS = false
LOG_LEVEL = "INFO"

[models]
CLASSIFICATION_MODEL_PATH = "models/classification/best_classification_model.pth"
SEGMENTATION_MODEL_PATH = "models/segmentation/best_unet_model.pth"

[thresholds]
CLASSIFICATION_THRESHOLD = 0.7
SEGMENTATION_THRESHOLD = 0.5
MIN_CONTOUR_AREA = 100

[limits]
MAX_FILE_SIZE_MB = 200
MAX_BATCH_SIZE = 20
MAX_HISTORY_ENTRIES = 1000

[ui]
DEFAULT_THEME = "dark"
SHOW_DEBUG_INFO = false
ENABLE_DOWNLOADS = true

[security]
ENABLE_AUTHENTICATION = false
SESSION_TIMEOUT_MINUTES = 60
MAX_LOGIN_ATTEMPTS = 5
